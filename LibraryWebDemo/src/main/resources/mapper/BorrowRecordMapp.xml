<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.library.mapper.BorrowRecordMapper">

    <insert id="insert">
        INSERT INTO borrow_records (book_id, borrow_time)
        VALUES (#{bookId}, #{borrowTime})
    </insert>

    <update id="updateReturnTime">
        UPDATE borrow_records
        SET return_time = NOW()
        WHERE book_id = #{bookId} AND return_time IS NULL
    </update>

</mapper>